# Copy to .env and fill in real values. Never commit .env.
# Every new environment variable must be added here with a dummy value.

NODE_ENV=development

# AWS (ADR 0003)
AWS_REGION=ap-southeast-1
AWS_PROFILE=puiya-dev
STAGE=staging

# Filled from the CDK stack outputs after `cdk deploy`
API_URL=https://replace-me.lambda-url.ap-southeast-1.on.aws
COGNITO_USER_POOL_ID=ap-southeast-1_replaceme
COGNITO_CLIENT_ID=replace-me

# LINE Login (verified by the Cognito custom sign-in Lambda)
LINE_LOGIN_CHANNEL_ID=0000000000
LINE_LOGIN_CHANNEL_SECRET=replace-me
# LINE Messaging API (receipts to farmers)
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=replace-me

# Error tracking (leave empty locally)
SENTRY_DSN=
