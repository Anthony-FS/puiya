{
  "name": "puiya",
  "private": true,
  "description": "Offline-first POS and compliance app for Thailand's farm-input shops",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
